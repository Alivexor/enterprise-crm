# Copy this file to .env before running Docker Compose.
POSTGRES_DB=enterprise_crm
POSTGRES_USER=enterprise_crm
POSTGRES_PASSWORD=<strong-local-database-password>

DEFAULT_ORGANIZATION_ID=<organization-uuid>
DEFAULT_ORGANIZATION_NAME=Enterprise CRM
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=<development-password-of-at-least-12-characters>
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=User

JWT_SECRET=<strong-random-secret-at-least-32-bytes>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_SELF_REGISTRATION=false

FRONTEND_PORT=3000
BACKEND_PORT=8000
AUTH_REFRESH_TOKEN_MAX_AGE_SECONDS=604800
BACKEND_API_TIMEOUT_MS=10000

# Request / data safety limits
HTTP_MAX_REQUEST_BYTES=26214400
ATTACHMENT_MAX_UPLOAD_BYTES=10485760
IMPORT_EXPORT_MAX_UPLOAD_BYTES=5242880
IMPORT_EXPORT_MAX_ROWS=5000

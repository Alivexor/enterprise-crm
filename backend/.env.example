# PostgreSQL SQLAlchemy URL. Replace both placeholders with local credentials.
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/enterprise_crm
ENVIRONMENT=development
DEFAULT_ORGANIZATION_ID=<organization-uuid>
DEFAULT_ORGANIZATION_NAME=Enterprise CRM
# Public registration is disabled by default. Enable only when an approved onboarding flow exists.
ALLOW_SELF_REGISTRATION=false
# Attachments are disabled by default. For local development only, set the backend
# to local and choose a private, ignored directory such as .attachments.
ATTACHMENT_STORAGE_BACKEND=disabled
# ATTACHMENT_LOCAL_STORAGE_PATH=.attachments
ATTACHMENT_MAX_UPLOAD_BYTES=10485760
# CSV import/export limits. Keep these bounded to protect application resources.
IMPORT_EXPORT_MAX_UPLOAD_BYTES=5242880
IMPORT_EXPORT_MAX_ROWS=5000
# Global HTTP body limit; keep this above individual upload limits.
HTTP_MAX_REQUEST_BYTES=26214400
# Development seed configuration. Never commit an actual password.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=<development-password-of-at-least-12-characters>
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=User
# Generate at least 32 random bytes, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<strong-random-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional: when set, registration requires this role to exist in the organization.
# DEFAULT_ROLE_NAME=member
# Optional zero-paid-API local AI. Ollama listens locally by default.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=60


# Revenue controls
QUOTE_APPROVAL_DISCOUNT_THRESHOLD=20

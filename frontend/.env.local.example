# Public browser-facing base path for the Next.js authentication boundary.
NEXT_PUBLIC_API_BASE_URL=/api

# Server-only URL for the FastAPI API. Do not expose secrets here.
BACKEND_API_URL=http://localhost:8000/api/v1

# Server-side BFF timeout for FastAPI requests, in milliseconds.
BACKEND_API_TIMEOUT_MS=10000

# Keep this aligned with the backend JWT refresh-token lifetime.
AUTH_REFRESH_TOKEN_MAX_AGE_SECONDS=604800
